# Copy this file to `.env` and fill in your keys.

# Agent / generator model (required) — get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Embeddings (Day 4+). Only needed if you use Gemini instead of local BGE-M3/Ollama.
# GOOGLE_API_KEY=...

# Local BGE-M3 via Ollama needs NO key — just run `ollama serve` and `ollama pull bge-m3`.
